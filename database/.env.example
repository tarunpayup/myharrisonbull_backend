# Harrison Bull Backend - Database Configuration

# ============================================================
# RENDER.COM PostgreSQL Configuration
# ============================================================
# Get these values from your Render PostgreSQL instance:
# 1. Go to Render Dashboard > PostgreSQL
# 2. Copy the External Database URL
# 3. Use format: postgresql://user:password@host:port/dbname

# Full connection string (recommended for Render)
DATABASE_URL=postgresql://user:password@host.render.com:5432/harrison_bull_db

# Alternative: Individual settings (if using custom connection)
# DATABASE_HOST=host.render.com
# DATABASE_PORT=5432
# DATABASE_NAME=harrison_bull_db
# DATABASE_USER=user
# DATABASE_PASSWORD=password

# Connection Pool Settings
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=10
DATABASE_IDLE_TIMEOUT=30000
DATABASE_CONNECTION_TIMEOUT=10000

# SSL Configuration (for production)
DATABASE_SSL=false
# DATABASE_SSL_CERT_PATH=/path/to/cert.pem
# DATABASE_SSL_KEY_PATH=/path/to/key.pem
# DATABASE_SSL_CA_PATH=/path/to/ca.pem

# Logging
DATABASE_LOG_QUERIES=true
DATABASE_LOG_LEVEL=debug

# Node Environment
NODE_ENV=development
# NODE_ENV=production (for production deployments)

# API Server Settings
API_HOST=0.0.0.0
API_PORT=3000
API_URL=http://localhost:3000

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:3000

# JWT Settings (for authentication)
JWT_SECRET=your_super_secret_key_change_in_production
JWT_EXPIRES_IN=7d

# Email Configuration (for notifications)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password
SMTP_FROM=noreply@harrisonbull.com

# AWS S3 Configuration (for file uploads)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_access_key
AWS_SECRET_ACCESS_KEY=your_secret_key
AWS_S3_BUCKET=harrison-bull-assets

# Payment Processing (Stripe or similar)
STRIPE_PUBLIC_KEY=pk_test_...
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Logging & Monitoring
LOG_LEVEL=info
SENTRY_DSN=https://...
